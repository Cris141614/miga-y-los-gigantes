# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Blender: copias de respaldo automaticas
*.blend1
*.blend2

# Respaldos locales de versiones anteriores de un personaje (Git ya guarda el historial)
_respaldo*/

# Obsidian: estado local de la interfaz
docs/.obsidian/workspace*.json
docs/.obsidian/cache
docs/.trash/

# Temporales
*.tmp
*.bak

# Unity crea este .meta porque existe Assets/Plugins/Sentry/, que no se sube (tiene el token de Sentry).
# shortcut: si algun dia se sube otro plugin a Assets/Plugins/, quitar esta linea y subir el .meta.
juego/Assets/Plugins.meta
